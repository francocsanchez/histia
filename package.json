{
  "name": "histia",
  "version": "0.1.0",
  "private": true,
  "_moduleAliases": {
    "@": "dist/src"
  },
  "scripts": {
    "postinstall": "node scripts/patch-baileys.js",
    "dev": "concurrently -k -n app,worker -c blue,green \"next dev\" \"tsx scripts/whatsapp-worker.ts\"",
    "build": "next build",
    "build:scripts": "node -e \"require('node:fs').rmSync('dist/scripts',{ recursive: true, force: true })\" && tsc -p tsconfig.scripts.json",
    "start": "next start",
    "start:prod": "node dist/scripts/start-prod.js",
    "start:worker": "node dist/scripts/whatsapp-worker.js",
    "dev:worker": "tsx scripts/whatsapp-worker.ts",
    "lint": "eslint .",
    "test:mercadopago": "tsx --test scripts/tests/mercadopago-sync.test.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:admin:prod": "node dist/scripts/seed-admin.js"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.6.25",
    "@hookform/resolvers": "^5.7.1",
    "@types/qrcode": "^1.5.6",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^5.6.0",
    "libphonenumber-js": "^1.13.11",
    "lucide-react": "^1.28.0",
    "module-alias": "^2.3.4",
    "mongodb": "^7.5.0",
    "mongoose": "^9.9.1",
    "next": "^16.3.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.84.0",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.4",
    "typescript": "^5"
  }
